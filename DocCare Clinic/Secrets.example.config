<?xml version="1.0" encoding="utf-8"?>
<!-- Copy this file to Secrets.config (same folder) and fill in the real values.
     Secrets.config is ignored by git so passwords and keys never reach GitHub. -->
<appSettings>
  <!-- Gmail "App password" for the clinic sender address (EmailService.cs) -->
  <add key="SmtpPassword" value="" />
  <!-- Razorpay dashboard: Settings > API Keys -->
  <add key="RazorpayKeyId" value="" />
  <add key="RazorpayKeySecret" value="" />
</appSettings>

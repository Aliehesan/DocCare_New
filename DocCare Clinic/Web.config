<?xml version="1.0" encoding="utf-8"?>

<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->

<configuration>
  <!-- Passwords and keys (SmtpPassword, RazorpayKeyId, RazorpayKeySecret) live in Secrets.config,
       which is not uploaded to GitHub. Copy Secrets.example.config to Secrets.config to set them. -->
  <appSettings file="Secrets.config">
  </appSettings>

  <connectionStrings>
    <add name="DocCareDB" connectionString="Data Source=(LocalDb)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\DocCare.mdf;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="en-IN" uiCulture="en-IN" />
    <pages>
      <controls>
        <add tagPrefix="ajaxToolkit" namespace="AjaxControlToolkit" assembly="AjaxControlToolkit" />
      </controls>
    </pages>
    <authentication mode="Forms">
      <forms loginUrl="~/Features/Accounts/Login.aspx" timeout="1440" />
    </authentication>
    <httpHandlers>
      <add verb="POST" path="api/create-order" type="DocCare_Clinic.Api.CreateOrderHandler, DocCare Clinic" />
      <add verb="POST" path="api/verify-payment" type="DocCare_Clinic.Api.VerifyPaymentHandler, DocCare Clinic" />
    </httpHandlers>
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <httpErrors existingResponse="PassThrough" />
    <handlers>
      <add name="CreateOrderDirect" verb="POST" path="api/create-order" type="DocCare_Clinic.Api.CreateOrderHandler, DocCare Clinic" />
      <add name="VerifyPaymentDirect" verb="POST" path="api/verify-payment" type="DocCare_Clinic.Api.VerifyPaymentHandler, DocCare Clinic" />
    </handlers>
  </system.webServer>

  <!-- Allow all users to access Razorpay API endpoints without FormsAuthentication redirect -->
  <location path="api">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

</configuration>

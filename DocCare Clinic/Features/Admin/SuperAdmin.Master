                    <!-- Appointments -->
                    <li id="menuAppointment"><a href="<%= ResolveUrl("~/Features/Appointments/Appointments.aspx") %>"><span class="menu-side">
                        <svg width="21" height="20" viewbox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">

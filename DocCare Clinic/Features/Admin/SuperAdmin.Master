<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SuperAdmin.Master.cs"
    Inherits="DocCare_Clinic.Main" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <%-- Light / dark mode: set before anything is drawn (assets/js/doccare-theme.js) --%>
    <script>(function () { try { if (localStorage.getItem('doccare-theme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch (e) { } })();</script>
    <base href="<%= ResolveUrl("~/") %>" />
    <%--<meta charset="utf-8">--%>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0" />
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon.png" />
    <title>DocCare</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/select2.min.css" />
    <link rel="stylesheet" href="~/assets/plugins/datatables/datatables.min.css" />
    <link rel="stylesheet" href="~/assets/css/feather.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/doccare-custom.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/doccare-dark.css" />
    <script src="assets/js/doccare-theme.js" type="text/javascript"></script>
    <style>
        li.active a
        {
            color: #2E37A4 !important;
        }
        #loader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #ffffff;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loader-content {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    #loader img {
        width: 70px;
        height: auto;
        margin-bottom: 10px; /* Space between logo and text */
        animation: pulse 1.5s infinite;
    }

    #loader p {
        font-family: Arial, sans-serif;
        font-size: 18px;
        font-weight: bold;
        color: #2E37A4;
        letter-spacing: 1px;
        text-transform: uppercase;
        animation: fade 1.5s infinite;
        margin: 0;
        margin-left:20px;
    }

    body.loaded #loader {
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.5s ease-out, visibility 0.5s ease-out;
    }

    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }

    @keyframes fade {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
   
    </style>
    <%-- Same as ReceptionistAdmin/DoctorAdmin masters, so pages shared by all staff
         (e.g. Manage_Doctor, DoctorsAppoinment) can be shown in the admin layout too --%>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <!-- SweetAlert2 + global helpers. Loaded in the page head so alerts registered from
         code-behind (RegisterStartupScript, rendered inside the form) can call them. -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Toast notification (success / error / info / warning)
        function swalToast(icon, title, timer) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: icon || 'success',
                title: title,
                showConfirmButton: false,
                timer: timer || 3000,
                timerProgressBar: true,
                customClass: { popup: 'swal-modern-popup' }
            });
        }

        // Confirm dialog - calls onConfirm() if user presses the confirm button
        function swalConfirm(title, text, icon, confirmText, onConfirm) {
            Swal.fire({
                title: title,
                text: text,
                icon: icon || 'warning',
                showCancelButton: true,
                confirmButtonColor: '#2E37A4',
                cancelButtonColor: '#6b7280',
                confirmButtonText: confirmText || 'Yes, Proceed',
                cancelButtonText: 'Cancel',
                customClass: { popup: 'swal-modern-popup' }
            }).then(function (result) {
                if (result.isConfirmed) {
                    onConfirm();
                }
            });
            return false;
        }

        // Error / Info alert (no confirm needed)
        function swalAlert(icon, title, text) {
            Swal.fire({
                icon: icon || 'error',
                title: title,
                text: text,
                confirmButtonColor: '#2E37A4',
                customClass: { popup: 'swal-modern-popup' }
            });
        }
    </script>
    <style>
        .swal-modern-popup {
            border-radius: 20px !important;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePartialRendering="true">
    </asp:ScriptManager>
    <div id="loader">
        <div class="loader-content">
            <img src="assets/img/logo.png" alt="Logo" />

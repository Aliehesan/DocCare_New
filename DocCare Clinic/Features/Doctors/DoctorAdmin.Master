    <script src="assets/js/jquery-3.7.1.min.js" type="text/javascript"></script>
    <script src="assets/js/bootstrap.bundle.min.js" type="text/javascript"></script>
    <script src="assets/js/feather.min.js" type="text/javascript"></script>
    <script src="assets/js/jquery.slimscroll.js" type="text/javascript"></script>
    <script src="assets/js/select2.min.js" type="text/javascript"></script>
    <script src="assets/plugins/datatables/jquery.dataTables.min.js" type="text/javascript"></script>
    <script src="assets/plugins/datatables/datatables.min.js" type="text/javascript"></script>
    <script src="assets/js/jquery.waypoints.js" type="text/javascript"></script>
    <script src="assets/js/jquery.counterup.min.js" type="text/javascript"></script>
    <script src="assets/plugins/apexchart/apexcharts.min.js" type="text/javascript"></script>
    <script src="assets/plugins/apexchart/chart-data.js" type="text/javascript"></script>
    <script src="assets/js/app.js" type="text/javascript"></script>
    <script src="assets/js/rocket-loader.min.js" data-cf-settings="ac36100db4dcb773c8560a0a-|49"
        defer></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var dropdowns = document.querySelectorAll('.dropdown-toggle');
            dropdowns.forEach(function (dropdown) {
                dropdown.addEventListener("click", function (event) {
                    event.stopPropagation(); // Prevent event from bubbling up
                    var menu = this.nextElementSibling;
                    document.querySelectorAll(".dropdown-menu").forEach(function (el) {
                        if (el !== menu) el.classList.remove("show");
                    });
                    menu.classList.toggle("show");
                });
            });

            document.addEventListener("click", function () {
                document.querySelectorAll(".dropdown-menu").forEach(function (el) {
                    el.classList.remove("show");
                });
            });
        });
    </script>
    <script>
        // ✅ Highlight the active menu based on page URL
        var url = window.location.pathname.toLowerCase();

        // Map your URLs to their corresponding menu item IDs
        var menuMap = {
            "Features/Doctors/DoctorDashBoard.aspx": "menuDashboard",            
            "Features/Receptionists/Receptionist.aspx": "menuReceptionist",
            "Features/Doctors/Doctors.aspx": "menuDoctor",
            "Features/Patients/Patients.aspx": "menuPatient",
            "Features/Appointments/Appointments.aspx": "menuAppointment",
            "Features/Departments/Departments.aspx": "menuDepartment",
            "Features/Scheduling/Schedule.aspx": "menuSchedule",
            "Features/Site/Settings.aspx": "menuSetting",
        };

        // Loop through the menuMap to find the current page
        for (var key in menuMap) {
            var menuItem = document.getElementById(menuMap[key]);
            if (menuItem && url.includes(key.toLowerCase())) {
                menuItem.classList.add("active");
                break;
            }
        }
    </script>
    <script>
        window.addEventListener('load', function () {
            document.body.classList.add('loaded');
        });
    </script>
    <asp:Literal ID="Literal1" runat="server">
    <div class="sidebar-overlay" data-reff></div>
</asp:Literal>
    <script>
        $(document).on('click', '.sidebar-overlay', function () {
            $('.sidebar-overlay').removeClass('active');
            $('.main-wrapper').removeClass('slide-nav');
        });
</script>
</body>
<script>
    // ✅ Toggle Sidebar on Toggle Button Click
    document.getElementById("toggle_btn").addEventListener("click", function () {
        var sidebar = document.getElementById("sidebar");
        sidebar.classList.toggle("active"); // Add/Remove active class for sidebar
    });

    // ✅ Toggle Sidebar on Mobile Button Click
    document.getElementById("mobile_btn").addEventListener("click", function (e) {
        e.preventDefault();
        var sidebar = document.getElementById("sidebar");
        sidebar.classList.toggle("active"); // Add/Remove active class for mobile sidebar
    });

    // ✅ Close Sidebar When Click Outside (Optional)
    document.addEventListener("click", function (event) {
        var sidebar = document.getElementById("sidebar");
        var toggleBtn = document.getElementById("toggle_btn");
        var mobileBtn = document.getElementById("mobile_btn");

        // Close sidebar if clicked outside and not on toggle buttons
        if (!sidebar.contains(event.target) && event.target !== toggleBtn && event.target !== mobileBtn) {
            sidebar.classList.remove("active");
        }
    });
</script>
<script>
    // ✅ Show Loader on Page Load
    window.addEventListener('load', function () {
        document.getElementById("loader").style.display = "none";
    });

    // ✅ Show Loader on Page Change
    document.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", function () {
            document.getElementById("loader").style.display = "flex";
        });
    });
</script>
<script>
    // ✅ Show Loader Until Page Loads
    window.addEventListener('load', function () {
        var loader = document.getElementById("loader");
        loader.classList.add("fade-out"); // Smooth fade out
        setTimeout(function () {
            loader.style.display = "none";
        }, 500);
    });

    // ✅ Show Loader on Page Change
    document.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", function () {
            document.getElementById("loader").style.display = "flex";
        });
    });
</script>
</html>
